# Copy to backend/.env

# Database. Defaults to a local SQLite file when unset.
# For PostgreSQL (including Supabase), use the connection string:
# DATABASE_URL=postgresql://remi:remi@localhost:5432/remi

# Optional. Without a key, Remi uses its built-in rule-based planner.
# Get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173
